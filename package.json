{
  "name": "@local/approval-zh",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "DSH Host+Client plugin: 权限确认窗口（审批面板）中文化 —— 接管 conversation.composer 审批卡片并用中文重绘，翻译授权原因与命令明细；本地词表优先，model_router 兜底。",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-approval"
      ]
    }
  }
}
